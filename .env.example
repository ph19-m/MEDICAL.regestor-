DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for automatic clinic admin account creation during registration:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public production URL used in WhatsApp tracking links.
NEXT_PUBLIC_APP_URL=https://medical-regestor-jpri.vercel.app
# APP_URL can be used instead of NEXT_PUBLIC_APP_URL on the server.
# APP_URL=https://medical-regestor-jpri.vercel.app

# Owner email notifications for new clinic registration.
PLATFORM_OWNER_EMAIL=your-personal-email@example.com
# Replies from clinic decision emails go to this address. Defaults to PLATFORM_OWNER_EMAIL.
OWNER_REPLY_TO_EMAIL=your-personal-email@example.com
EMAIL_FROM="Dawri Medical <onboarding@your-domain.com>"
RESEND_API_KEY=your-resend-api-key
# Secret used to sign approve/reject review links sent by email.
EMAIL_ACTION_SECRET=change-this-long-random-secret

# Optional for local Postgres without SSL:
# PGSSLMODE=disable
# Optional local-only JSON fallback for offline demo work:
# DAWRI_ALLOW_JSON_FALLBACK=true

# Optional performance tuning for Vercel/Supabase.
# Keep short so queue and appointment updates stay fresh.
DB_READ_CACHE_MS=8000
PUBLIC_BOOTSTRAP_CACHE_MS=20000
PUBLIC_ROUTE_CACHE_MS=10000

# Staff/API protection. Change these in Vercel before showing the demo publicly.
STAFF_ACCESS_CODE=clinic-2026
SUPER_ADMIN_ACCESS_CODE=owner-2026
# Keep false in production. If true, STAFF_ACCESS_CODE can see all clinic data.
ALLOW_GLOBAL_STAFF_ACCESS=false
